@startuml
'!pragma ratio 1.3
skinparam nodesep 15
skinparam ranksep 15
skinparam linetype ortho
left to right direction
'!theme crt-green7

actor Utilizator as U
actor "Platformă Externă" as PE <<System>>
actor Dezvoltator as Dev

usecase "Publică actualizări software" as update

rectangle "Sistemul de Monitorizare a Mediului" #ecebe9 {
    rectangle "Aplicația Mobilă" << Subsystem >> #fbfaf8 {
        usecase "Vizualizează datele" as ap_1
            usecase "Afișarea graficului" as ap_11
        together {
            usecase "Exportează datele" as ap_2
                usecase "Exportare în format CSV" as ap_21
                usecase "Exportare în format XML" as ap_22
                usecase "Exportare în format JSON" as ap_23
                usecase "Exportare în format SQLITE" as ap_24
        }
        usecase "Gestionarea sistemului" as ap_3
            together {
                usecase "Gestionarea dispozitivelor" as ap_31
                    usecase "Adăugare dispozitiv" as ap_311
                    usecase "Șterge dispozitiv" as ap_312
            }
            together {
                usecase "Gestionare alarme" as ap_32
                    usecase "Creare alarmă" as ap_321
                    usecase "Ștergere alarmă" as ap_322
                    usecase "Armare alarmă" as ap_323
                    usecase "Dezarmare alarmă" as ap_324
            }
            together {
                usecase "Gestionează versiune software" as ap_33
                    usecase "Verifică disponibilitatea unei noi\n versiuni software" as ap_331
                    usecase "Actualizează software-ul\n pentru dispozitiv" as ap_332
            }
        usecase "Conectare la platforma\n externa " as ap_4
        together {
            usecase "Obținerea datelor" as ap_5
            usecase "Stocarea datelor \nin baza de date" as ap_6
            usecase "Citirea datelor din\n baza de date" as ap_7
        }
    }

    rectangle "Dispozitiv de monitorizare" << Subsystem >> #fbfaf8 {
        usecase "Creare alarmă" as dv_11
        usecase "Ștergere alarmă" as dv_12
        usecase "Armare alarmă" as dv_13
        usecase "Dezarmare alarmă" as dv_14
        usecase "Actualizează software-ul\n pentru dispozitiv" as dv_2
        usecase "Conectare la platforma\n externa " as dv_3
        usecase "Autorizare conexiune" as dv_4
        usecase "Colectare date" as dv_5
        usecase "Transmitere date" as dv_6
    }
}

U -- ap_1
    ap_1 <.. ap_11 : <<extends>>
U -- ap_2
    ap_2 <|--- ap_21
    ap_2 <|--- ap_22
    ap_2 <|--- ap_23
    ap_2 <|--- ap_24
U -- ap_3
    ap_3 -- ap_31
        ap_31 -- ap_311
            ap_311 -- dv_4
        ap_31 -- ap_312
    ap_3 -- ap_32
        ap_32 <.. ap_321 : <<extends>>
        ap_32 <.. ap_322 : <<extends>>
        ap_32 <.. ap_323 : <<extends>>
        ap_32 <.. ap_324 : <<extends>>
            ap_321 -- dv_11
            ap_322 -- dv_12
            ap_323 -- dv_13
            ap_324 -- dv_14
    ap_3 -- ap_33
        ap_33 -- update
        ap_33 ...> ap_331 : <<include>>
        ap_33 <... ap_332 : <<extends>>
            ap_332 -- dv_2
ap_21 ...> ap_7 : <<include>>            
ap_22 ...> ap_7 : <<include>>            
ap_23 ...> ap_7 : <<include>>            
ap_24 ...> ap_7 : <<include>>            
ap_1 ...> ap_7 : <<include>>
ap_5 ..> ap_6 : <<include>>
ap_7 -- ap_5
ap_5 -- dv_6

dv_5 -- dv_6

U -- ap_4
    ap_4 -- dv_3
PE -- dv_3
PE -- ap_4

Dev --> update

@enduml
