		<nd_view id="Network Chart View 2" pagelayout="Network Chart Page Layout" borderpolicy="criticalpath" borderfillpolicy="criticalpath" bordershadowpolicy="criticalpath" hyperlinksymbols="yes" indicatenotes="yes" indicateconstraint="yes" indicatecompleted="yes" field="Duration" hspacing="5.05pt">
			<border id="Critical Task" shdir="bottom_right" shdepth="2.25pt" shcolor="red" color="red" bkcolor="lightyellow" bkstyle="gradient_top_bottom">
				<border_edge id="top" color="red"/>
