		<ts_view id="Swim Lane View" pagelayout="Gantt Chart Page Layout" ganttchart="yes" swimlanechart="yes" exhdr="small" packbars="yes" lockfirst="no" fonttextpolicy="criticalpath" fontfillpolicy="criticalpath">
			<columns>
			</columns>
			<gantt>
				<options/>
				<grid id="summary" rows="3" cols="5" top="1" left="1" bottom="1" right="3" cliptext="no">
					<row stretch="yes">
						<cell halign="right" rowspan="3"/>
						<cell halign="left"/>
						<cell stretch="yes"/>
						<cell halign="right"/>
						<cell halign="left" rowspan="3"/>
					</row>
					<row>
						<cell field="Name" font-size="10pt" bold="yes" colspan="3"/>
					</row>
					<row stretch="yes">
						<cell halign="left"/>
						<cell/>
						<cell halign="right"/>
					</row>
				</grid>
				<grid id="task" rows="3" cols="5" top="1" left="1" bottom="1" right="3" cliptext="no">
					<row stretch="yes">
						<cell halign="right" rowspan="3"/>
						<cell halign="left"/>
						<cell stretch="yes"/>
						<cell halign="right"/>
						<cell halign="left" rowspan="3"/>
					</row>
					<row>
						<cell field="Name" font-size="10pt" bold="yes" colspan="3"/>
					</row>
					<row stretch="yes">
						<cell halign="left"/>
						<cell/>
						<cell halign="right"/>
					</row>
				</grid>
				<grid id="milestone" rows="3" cols="5" top="1" left="1" bottom="1" right="3" cliptext="no">
					<row stretch="yes">
						<cell halign="right" right_p="7.2pt" rowspan="3"/>
						<cell halign="left"/>
						<cell field="Name" font-size="10pt" bold="yes" stretch="yes"/>
						<cell halign="right"/>
						<cell halign="left" left_p="7.2pt" rowspan="3"/>
					</row>
					<row>
						<cell colspan="3"/>
					</row>
					<row stretch="yes">
						<cell halign="left"/>
						<cell/>
						<cell halign="right"/>
					</row>
				</grid>
				<timescale tier="0"/>
				<timescale tier="1"/>
				<line id="start"/>
				<line id="finish"/>
				<line id="status"/>
				<line id="current"/>
				<line id="row"/>
				<line id="timescale"/>
				<line id="uppertimescale"/>
				<bar id="Critical Task" width="full" style="framedsolid" color="pink"/>
				<bar id="Critical Milestone" width="full" style="framedsolid" color="red">
