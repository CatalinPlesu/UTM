		<ts_view id="Gantt Chart with Slack" pagelayout="Gantt Chart Page Layout" ganttchart="yes" fonttextpolicy="criticalpath" fontfillpolicy="criticalpath">
			<columns>
				<column field="ID" aligndata="center" width="40"/>
				<column field="WBS" aligndata="left" width="50"/>
				<column field="Name" aligndata="left" width="275"/>
				<column field="Duration" aligndata="left" width="60"/>
				<column field="Start" width="75"/>
				<column field="Finish" width="75"/>
