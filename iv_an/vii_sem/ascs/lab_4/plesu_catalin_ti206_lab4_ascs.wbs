					<row stretch="yes">
						<cell halign="left"/>
						<cell/>
						<cell halign="right"/>
					</row>
				</grid>
				<grid id="milestone" rows="3" cols="5" top="1" left="1" bottom="1" right="3" cliptext="no">
					<row stretch="yes">
						<cell halign="right" right_p="7.2pt" rowspan="3"/>
						<cell halign="left"/>
						<cell stretch="yes"/>
						<cell halign="right"/>
						<cell field="Start" format="22" halign="left" bold="yes" left_p="7.2pt" rowspan="3"/>
					</row>
					<row>
						<cell colspan="3"/>
					</row>
					<row stretch="yes">
						<cell halign="left"/>
						<cell/>
						<cell halign="right"/>
					</row>
				</grid>
				<timescale tier="0"/>
				<timescale tier="1"/>
				<line id="start"/>
				<line id="finish"/>
				<line id="status"/>
				<line id="current"/>
				<line id="row"/>
				<line id="timescale"/>
				<line id="uppertimescale"/>
