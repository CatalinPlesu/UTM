         <sttext>if(Tags.airQ1 &gt;= 0.3)
{
	Tags.Buzzer1 = true;
	Tags.Relay_0 = true;
	Tags.Relay_1 = true;
	Tags.Lock = true;
}
else
{
	Tags.Buzzer1 = false;
	Tags.Lock = false;
}

if(Tags.airQ2 &gt;= 0.3)
{
	Tags.Buzzer2 = true;
	Tags.Relay_0 = true;
	Tags.Relay_1 = true;
	Tags.Lock = true;
}
else
{
	Tags.Buzzer2 = false;
	Tags.Lock = false;
}</sttext>
