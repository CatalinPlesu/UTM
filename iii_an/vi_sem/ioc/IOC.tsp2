   <scripts>
      <script name="Relay_Alarm" color="0xd3d3d3ff" type="0" windowheight="800" windowwidth="1200" groupname="" subgroupname="" language="1" everycycle="true" extype="3">
         <objects/>
         <links/>
         <sttext>int m = Tags.RTC_minutes;
int h = Tags.RTC_hours;
int d = Tags.RTC_day;
int ma = Tags.RTC_alarm_minutes;
int ha = Tags.RTC_alarm_hours;
int da = Tags.RTC_alarm_day;

if(Tags.Lock){}
else
{
if(m == ma &amp;&amp; h == ha &amp;&amp; d == da)
{
	Tags.Relay_0 = true;
	Tags.Relay_1 = true;
}
else
{
	Tags.Relay_0 = false;
	Tags.Relay_1 = false;
}	
}
</sttext>
         <opcodes>
            <opcode type="LOAD_TAG" datatype="-1">
               <value>RTC_minutes</value>
            </opcode>
            <opcode type="STORE" datatype="3">
               <value>m</value>
            </opcode>
            <opcode type="LOAD_TAG" datatype="-1">
               <value>RTC_hours</value>
            </opcode>
            <opcode type="STORE" datatype="3">
               <value>h</value>
            </opcode>
            <opcode type="LOAD_TAG" datatype="-1">
               <value>RTC_day</value>
            </opcode>
            <opcode type="STORE" datatype="3">
               <value>d</value>
            </opcode>
            <opcode type="LOAD_TAG" datatype="-1">
               <value>RTC_alarm_minutes</value>
            </opcode>
            <opcode type="STORE" datatype="3">
               <value>ma</value>
            </opcode>
            <opcode type="LOAD_TAG" datatype="-1">
               <value>RTC_alarm_hours</value>
            </opcode>
            <opcode type="STORE" datatype="3">
               <value>ha</value>
            </opcode>
            <opcode type="LOAD_TAG" datatype="-1">
               <value>RTC_alarm_day</value>
            </opcode>
            <opcode type="STORE" datatype="3">
               <value>da</value>
            </opcode>
            <opcode type="LOAD_TAG" datatype="-1">
               <value>Lock</value>
            </opcode>
            <opcode type="JUMP_IF_FALSE" datatype="-1">
               <value>2</value>
            </opcode>
            <opcode type="JUMP" datatype="-1">
               <value>22</value>
            </opcode>
            <opcode type="LOAD_FAST" datatype="-1">
               <value>da</value>
            </opcode>
            <opcode type="LOAD_FAST" datatype="-1">
               <value>d</value>
            </opcode>
            <opcode type="BINARY_EQ" datatype="-1"/>
            <opcode type="LOAD_FAST" datatype="-1">
               <value>ha</value>
            </opcode>
            <opcode type="LOAD_FAST" datatype="-1">
               <value>h</value>
            </opcode>
            <opcode type="BINARY_EQ" datatype="-1"/>
            <opcode type="LOAD_FAST" datatype="-1">
               <value>ma</value>
            </opcode>
            <opcode type="LOAD_FAST" datatype="-1">
               <value>m</value>
            </opcode>
            <opcode type="BINARY_EQ" datatype="-1"/>
            <opcode type="BOOLEAN_AND" datatype="-1"/>
            <opcode type="BOOLEAN_AND" datatype="-1"/>
            <opcode type="JUMP_IF_FALSE" datatype="-1">
               <value>6</value>
            </opcode>
            <opcode type="LOAD_CONST" datatype="0">
               <value>true</value>
            </opcode>
            <opcode type="STORE_TAG" datatype="-1">
               <value>Relay_0</value>
            </opcode>
            <opcode type="LOAD_CONST" datatype="0">
               <value>true</value>
            </opcode>
            <opcode type="STORE_TAG" datatype="-1">
               <value>Relay_1</value>
