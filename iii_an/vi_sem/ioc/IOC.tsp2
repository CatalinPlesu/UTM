      <script name="RTC_TIME" color="0xd3d3d3ff" type="0" windowheight="800" windowwidth="1200" groupname="" subgroupname="" language="1" everycycle="true" extype="0">
         <objects/>
         <links/>
         <sttext>int h = datetime(3);
int m = datetime(1);

//int h = datetime(1);
//int m = datetime(0);

Tags.RTC_hours = h;
Tags.RTC_minutes = m;
Tags.RTC_day = datetime(4);
</sttext>
         <opcodes>
            <opcode type="LOAD_CONST" datatype="4">
               <value>3</value>
            </opcode>
            <opcode type="LOAD_FAST" datatype="-1">
               <value>datetime</value>
            </opcode>
            <opcode type="CALL" datatype="-1">
