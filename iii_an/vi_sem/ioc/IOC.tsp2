      <script name="Variate" color="0xd3d3d3ff" type="0" windowheight="800" windowwidth="1200" groupname="" subgroupname="" language="1" everycycle="true" extype="0">
         <objects/>
         <links/>
         <sttext>if(Tags.airQ1 &gt; 0.4)
{
Tags.airQ1 = Tags.airQ1 + 0.01;
Tags.airQ2 = Tags.airQ2 + 0.01;
Tags.temp1 = Tags.temp1 + 0.1;
Tags.temp2 = Tags.temp2 + 0.1;
}
else
{
Tags.airQ1 = Tags.airQ1 - 0.01;
Tags.airQ2 = Tags.airQ2 - 0.01;
Tags.temp1 = Tags.temp1 - 0.1;
Tags.temp2 = Tags.temp2 - 0.1;
}</sttext>
