   <scripts>
      <script name="script1" color="0xd3d3d3ff" type="0" windowheight="800" windowwidth="1000" groupname="" subgroupname="" language="1">
         <objects/>
         <links/>
         <sttext>
function updateVolum(a,b)
{ 
  Tags.volum_h2=Tags.volum_h2+a;
  Tags.volum_n2=Tags.volum_n2+b;
  Tags.presiune_h2=Tags.volum_h2/100;
  Tags.presiune_n2=Tags.volum_n2/100;
}

if(Tags.machine_state)
{
  if(Tags.presiune_h2&lt;100 &amp;&amp; Tags.presiune_n2&lt;100) {
  Tags.bec1=true;
  Tags.bec2=true;
  updateVolum(Tags.con_h2,Tags.con_n2);
  } else
   {
    Tags.bec1=false;
    Tags.bec2=false;
   }
  if(Tags.presiune_h2&gt;50 &amp;&amp; Tags.presiune_n2&gt;50)
  {
  	if(Tags.volum_amestec&lt;800){
  	Tags.bec3 = true;
  	Tags.volum_amestec=Tags.volum_amestec+100;
  	updateVolum(-100,-100);
  	} else
  	{
  	 Tags.bec3 = false;
	}
	if(Tags.volum_amestec&gt;700)
	{
		 Tags.volum_amestec=Tags.volum_amestec-127;
		  Tags.com_p_in=(Tags.presiune_h2+Tags.presiune_n2);
		   if(Tags.com_p_out&lt;7*(Tags.com_p_in))
		    {
		    	Tags.com_p_out=Tags.com_p_out+Tags.com_p_out*0.3+1;
		    }
		   Tags.bec4=true;
                    if(Tags.inc_t_out&lt; 227)
                    {
  			Tags.inc_t_out = Tags.inc_t_out + 5;
                    } else 
                    {Tags.inc_t_out=Tags.inc_t_out - 1;
		     }
		   
	} else
		{
		  Tags.bec4=false;
		  
		}
		 if(Tags.com_p_out&gt;7*Tags.com_p_in &amp;&amp; Tags.inc_t_out&gt;70)
		 {
		 	Tags.bec5=true;
		 	Tags.randament=(Tags.inc_t_out/(Tags.inc_t_in +1) )*0.45 +Tags.com_p_in*0.45;
		 	Tags.sinteza=(Tags.randament/10)*(Tags.com_p_out/Tags.inc_t_out);
		 } else {Tags.bec5=false;}
		if(Tags.bec5)
		{
		Tags.bec6=true;
		Tags.bec7=true;
		Tags.frig_t_in=Tags.inc_t_out-10;
		Tags.frig_t_out=4+0.05*Tags.frig_t_in;
		if(Tags.volum_nh3&lt;1000)
		{
			Tags.volum_nh3=Tags.volum_nh3+10;
		}else 
		{
		Tags.machine_state=false;
		}
		}else
		{
		Tags.bec6=false;
		Tags.bec7=false;
		}
  } else
   {
     Tags.bec3 = false;
    }
}
  else
{
  Tags.bec1 = false;
  Tags.bec2 = false;
  Tags.bec3=false;
Tags.bec4 = false;
Tags.bec5=false;
Tags.bec6=false;
Tags.bec7=false;
}

</sttext>
