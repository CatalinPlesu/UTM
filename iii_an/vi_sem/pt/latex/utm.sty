\usepackage[a4paper, margin=20mm, right=10mm]{geometry}

% Set font sizes for sections and subsections
\usepackage{sectsty}
\sectionfont{\fontsize{14}{16}\selectfont}
\subsectionfont{\fontsize{13}{15}\selectfont}

% Reset the section counter to start at 1
\setcounter{section}{0}
\renewcommand\thesection{\arabic{section}}

% Reset the subsection counter to start at 1
\setcounter{subsection}{0}
\renewcommand\thesubsection{\thesection.\arabic{subsection}}

\usepackage[romanian]{babel}

\usepackage{tocloft}

\renewcommand{\cfttoctitlefont}{\hfil\small\bfseries}
\renewcommand{\cftaftertoctitle}{\hfil}

% Define font styles for different levels of headings
\newcommand{\tocheadingfont}{\bfseries\fontsize{12}{14}\selectfont}
\newcommand{\tocsectionfont}{\bfseries\fontsize{12}{14}\selectfont}
\newcommand{\tocsubsectionfont}{\fontsize{12}{14}\selectfont}

% Set the style for the table of contents
\renewcommand{\cftsecfont}{\tocsectionfont}
\renewcommand{\cftsubsecfont}{\tocsubsectionfont}
\renewcommand{\cftsecpagefont}{\tocsectionfont}
\renewcommand{\cftsubsecpagefont}{\tocsubsectionfont}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}

