% numerotation for figures and tables
\renewcommand{\thefigure}{\arabic{section}.\arabic{figure}}
\renewcommand{\thetable}{\arabic{section}.\arabic{table}}


% format for figure and tables caption
\DeclareCaptionLabelSeparator{tire}{\,-- \;}
\captionsetup[figure]{labelformat=simple,labelsep=tire, belowskip=-0.2cm}
\captionsetup[lstlisting]{labelformat=simple,labelsep=tire, belowskip=-0.3cm}
\captionsetup[table]{labelformat=simple,position=top, labelsep=tire,singlelinecheck=false}

% format for enumeration and itemized lists
